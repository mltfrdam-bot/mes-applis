<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pas d'accès internet. Étape 2 : Bluetooth (ceinture H10) et service permanent. Étape 4 : GPS pendant une course. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- « Toujours autoriser » : facultatif, sert seulement à relancer le GPS si le téléphone a coupé l'appli pendant une séance -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 💧 rappels d'eau : l'alarme est remise en route après un redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|fontScale|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service permanent de séance : tient la ceinture H10, écoute le GPS et enregistre, même écran éteint -->
        <service
            android:name=".ServiceSeance"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- 💧 Rappels d'eau : vérification toutes les 30 min, boutons de la notification, redémarrage du téléphone -->
        <receiver android:name=".RappelEau" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 💧 Widget de l'eau sur l'écran d'accueil -->
        <receiver android:name=".WidgetTelecommande" android:exported="false" android:label="🎮 Télécommande">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fr.mesapplis.activite.TELECOMMANDE_BASCULER" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_telecommande_info" />
        </receiver>
        <service android:name=".ServiceTelecommande" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <activity android:name=".NoteVocale" android:exported="false" android:excludeFromRecents="true" android:taskAffinity=".note"
            android:showWhenLocked="true" android:turnScreenOn="true" android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <receiver android:name=".WidgetEau" android:exported="false" android:label="💧 Eau du jour">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_eau_info" />
        </receiver>

        <!-- 💧 Petite fenêtre « Combien as-tu bu ? » (sans ouvrir l'appli) -->
        <activity
            android:name=".AlarmeEau"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".eaualarme"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <activity
            android:name=".SaisieEau"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".eau"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <!-- 💧 Notification permanente de l'eau (au choix) : garde aussi l'appli active -->
        <service
            android:name=".ServiceEau"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Suivi personnel de l'eau bue : total du jour et boutons pour noter une boisson" />
        </service>

        <!-- Sert au menu « Partager » (envoi de la sauvegarde vers Google Drive) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chemins" />
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_ligne"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp">
    <ImageView
        android:id="@+id/poignee"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:layout_marginStart="-8dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:scaleType="center"
        android:src="@drawable/ic_poignee"
        android:visibility="gone" />
    <CheckBox
        android:id="@+id/caseChoix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/pochette"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_pochette"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/nouveau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_nouveau"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Nouveau"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <TextView
                android:id="@+id/titre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/texte"
                android:textSize="16sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/artiste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/gris"
            android:textSize="13sp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/etoile"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_etoile_vide" />
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/trait" />
    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
            android:id="@+id/duree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/ecoutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_clair"
            android:textSize="11sp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/menu"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_menu" />
    <ImageView
        android:id="@+id/retirer"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_fermer"
        android:visibility="gone" />
</LinearLayout>

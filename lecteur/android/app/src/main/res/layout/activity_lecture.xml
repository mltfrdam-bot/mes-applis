<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <ImageView
            android:id="@+id/btnFermer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_bas" />
        <TextView
            android:id="@+id/enTete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="Lecture en cours"
            android:textColor="@color/gris"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnAmbiance"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✨"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/btnStyle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pochette"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pochette"
        android:elevation="10dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/texte"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/artiste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:singleLine="true"
        android:textColor="@color/gris"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/zoneParoles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fadingEdgeLength="56dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/lignesParoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnFavori"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_etoile_vide" />
        <ImageView
            android:id="@+id/btnPlaylist"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_ajout_playlist" />
        <ImageView
            android:id="@+id/btnFile"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_file" />
        <LinearLayout
            android:id="@+id/btnMinuterie"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="56dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/icoMinuterie"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_minuterie" />
            <TextView
                android:id="@+id/texteMinuterie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/barre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp">
        <TextView
            android:id="@+id/tempsActuel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gris"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tempsTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnAleatoire"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:src="@drawable/ic_aleatoire" />
        <ImageView
            android:id="@+id/btnPrecedent"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="14dp"
            android:src="@drawable/ic_precedent" />
        <ImageView
            android:id="@+id/btnLecture"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_rond"
            android:elevation="6dp"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="20dp"
            android:src="@drawable/ic_lecture"
            android:tint="#FFFFFF" />
        <ImageView
            android:id="@+id/btnSuivant"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginEnd="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="14dp"
            android:src="@drawable/ic_suivant" />
        <ImageView
            android:id="@+id/btnRepetition"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:src="@drawable/ic_repetition" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lecteur"
                android:textColor="@color/texte"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/compteur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gris"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/btnActualiser" style="@style/BoutonHaut" android:text="🔄" />
        <TextView android:id="@+id/btnDonnees" style="@style/BoutonHaut" android:text="📊" />
        <TextView android:id="@+id/btnAide" style="@style/BoutonHaut" android:text="❓" />
    </LinearLayout>

    <TextView
        android:id="@+id/bandeau"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bandeau"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="12dp"
        android:textColor="#6B4A00"
        android:textSize="14sp"
        android:visibility="gone" />

    <include layout="@layout/barre_recherche" />

    <LinearLayout
        android:id="@+id/onglets"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <TextView android:id="@+id/ongletMusique" style="@style/Onglet" android:text="Musique" />
        <TextView android:id="@+id/ongletFavoris" style="@style/Onglet" android:text="★ Favoris" />
        <TextView android:id="@+id/ongletPlaylists" style="@style/Onglet" android:text="Playlists" />
        <TextView android:id="@+id/ongletDossiers" style="@style/Onglet" android:text="Dossiers" />
    </LinearLayout>

    <include layout="@layout/barre_tri" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/carte"
            android:scrollbars="vertical" />
        <LinearLayout
            android:id="@+id/vide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fond"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/texteVide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/texte"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/btnVide"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_bouton"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/mini_lecteur" />
</LinearLayout>

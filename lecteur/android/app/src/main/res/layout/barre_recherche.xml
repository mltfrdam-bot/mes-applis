<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_recherche"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp">
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_recherche" />
    <EditText
        android:id="@+id/recherche"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:hint="Rechercher un titre, un artiste, un dossier…"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/texte"
        android:textColorHint="@color/gris_clair"
        android:textSize="15sp" />
    <ImageView
        android:id="@+id/effacerRecherche"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_fermer"
        android:tint="#9AA0A8"
        android:visibility="gone" />
</LinearLayout>
